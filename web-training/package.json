{
  "name": "vibesafe-security-training",
  "version": "1.0.0",
  "description": "Interactive Security Training Platform for VibeSafe CLI Framework",
  "main": "src/index.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "deploy": "npm run build && serve -s build -l 3001",
    "dev": "concurrently \"npm start\" \"json-server --watch src/data/training-data.json --port 3001\""
  },
  "dependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@monaco-editor/react": "^4.6.0",
    "@mui/icons-material": "^5.11.0",
    "@mui/material": "^5.11.0",
    "axios": "^1.3.0",
    "chart.js": "^4.2.1",
    "framer-motion": "^10.0.0",
    "highlight.js": "^11.7.0",
    "monaco-editor": "^0.45.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^8.0.5",
    "react-router-dom": "^6.8.0",
    "react-scripts": "5.0.1",
    "react-syntax-highlighter": "^15.6.1",
    "recharts": "^3.1.2"
  },
  "devDependencies": {
    "concurrently": "^7.6.0",
    "json-server": "^0.17.1",
    "serve": "^14.2.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "security",
    "training",
    "vibesafe",
    "cybersecurity",
    "education",
    "interactive"
  ],
  "author": "VibeSafe Security Framework",
  "license": "MIT"
}
